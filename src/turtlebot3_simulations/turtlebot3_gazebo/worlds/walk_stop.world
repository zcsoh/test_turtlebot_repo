<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <actor name="actor">
      <pose>-10 0 0 0 0 0</pose>
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <waypoint>
            <time>0.0</time>
            <pose>-10 0 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>20.0</time>
            <pose>-5 0 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>40.0</time>
            <pose>-5 0 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>70.0</time>
            <pose>0 0 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>90.0</time>
            <pose>0 0 0 0 0 0</pose>
          </waypoint>
          
          <waypoint>
            <time>120.0</time>
            <pose>5 0 0 0 0 0</pose>
          </waypoint>

          <waypoint>
            <time>140.0</time>
            <pose>5 0 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
